-- Wires Automation
local wireConnections = {}
local wireRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ClickWire")
local wiresFolder = workspace:WaitForChild("FuseBox"):WaitForChild("Wires")

local function hookWire(wire)
    if wire:FindFirstChild("Highlight") then
        if wire.Highlight.Enabled then
            wireRemote:FireServer(wire)
        end
        table.insert(wireConnections, wire.Highlight:GetPropertyChangedSignal("Enabled"):Connect(function()
            if getgenv().wireLoop and wire.Highlight.Enabled then
                wireRemote:FireServer(wire)
            end
        end))
    end
end

local AutoFixFuseToggle = MainTab:CreateToggle({
    Name = "Auto Fix Fuse",
    CurrentValue = false,
    Flag = "AutoFixFuse",
    Callback = function(Value)
        getgenv().wireLoop = Value
        if Value then
            for _, wire in ipairs(wiresFolder:GetChildren()) do
                hookWire(wire)
            end
        else
            for _, conn in ipairs(wireConnections) do
                conn:Disconnect()
            end
            wireConnections = {}
        end
    end,
})


-- Custom Corner Bracket ESP for Mutant
local cornerLines = {}
for i = 1, 8 do
    local l = Drawing.new("Line")
    l.Visible = false
    l.Thickness = 2
    l.Color = Color3.fromRGB(255, 60, 60)
    table.insert(cornerLines, l)
end

local espText = Drawing.new("Text")
espText.Center = true
espText.Visible = false
espText.Font = 2
espText.Outline = true
espText.Color = Color3.fromRGB(255, 255, 255)
espText.Size = 16

RunService.RenderStepped:Connect(function()
    if not getgenv().espLoop then
        for _, l in ipairs(cornerLines) do l.Visible = false end
        espText.Visible = false
        return
    end

    local mutant = workspace:FindFirstChild("Mutant")
    local char = getCharacter()

    if mutant and mutant:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
        local vector, onScreen = workspace.CurrentCamera:WorldToViewportPoint(mutant.HumanoidRootPart.Position)
        if onScreen then
            local size = Vector2.new(1800 / vector.Z, 3200 / vector.Z)
            local pos = Vector2.new(vector.X - size.X / 2, vector.Y - size.Y / 2)
            
            local x, y, w, h = pos.X, pos.Y, size.X, size.Y
            local length = math.clamp(w / 4, 6, 16)

            -- Top-Left Corner
            cornerLines[1].From = Vector2.new(x, y)
            cornerLines[1].To = Vector2.new(x + length, y)
            cornerLines[2].From = Vector2.new(x, y)
            cornerLines[2].To = Vector2.new(x, y + length)

            -- Top-Right Corner
            cornerLines[3].From = Vector2.new(x + w, y)
            cornerLines[3].To = Vector2.new(x + w - length, y)
            cornerLines[4].From = Vector2.new(x + w, y)
            cornerLines[4].To = Vector2.new(x + w, y + length)

            -- Bottom-Left Corner
            cornerLines[5].From = Vector2.new(x, y + h)
            cornerLines[5].To = Vector2.new(x + length, y + h)
            cornerLines[6].From = Vector2.new(x, y + h)
            cornerLines[6].To = Vector2.new(x, y + h - length)

            -- Bottom-Right Corner
            cornerLines[7].From = Vector2.new(x + w, y + h)
            cornerLines[7].To = Vector2.new(x + w - length, y + h)
            cornerLines[8].From = Vector2.new(x + w, y + h)
            cornerLines[8].To = Vector2.new(x + w, y + h - length)

            for _, l in ipairs(cornerLines) do l.Visible = true end

            espText.Visible = true
            espText.Position = Vector2.new(vector.X, y - 22)
            local dist = math.floor((char.HumanoidRootPart.Position - mutant.HumanoidRootPart.Position).Magnitude)
            espText.Text = "MUTANT [" .. dist .. "m]"
        else
            for _, l in ipairs(cornerLines) do l.Visible = false end
            espText.Visible = false
        end
    else
        for _, l in ipairs(cornerLines) do l.Visible = false end
        espText.Visible = false
    end
end)


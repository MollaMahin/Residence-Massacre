-- Original Stats Storage
local originalStats = {}

local function updateOriginalStats(char)
    local sprint = char:WaitForChild("Sprint", 5)
    local breath = char:WaitForChild("Breath", 5)
    if sprint and breath then
        originalStats.stam = {
            max = sprint.Stam:GetAttribute("Max"),
            val = sprint.Stam.Value
        }
        originalStats.breath = {
            max = breath:GetAttribute("Max"),
            val = breath.Value
        }
        originalStats.overdrive = sprint.Overdrive.Value
    end
end

if localPlayer.Character then
    updateOriginalStats(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(updateOriginalStats)


getgenv().AutoFill = false
local generator = workspace.Shack.Generator
local fuelVal = generator:WaitForChild("Fuel")
local jerryCan = workspace.Shack.JerryCan

local AutoFillGenToggle = GeneratorTab:CreateToggle({
    Name = "Auto Fill Generator",
    CurrentValue = false,
    Flag = "AutoFillGen",
    Callback = function(Value)
        getgenv().AutoFill = Value
    end,
})

local isFilling = false
local oldPos = nil
RunService.Heartbeat:Connect(function()
    if getgenv().AutoFill and fuelVal then
        local root = getCharacter():WaitForChild("HumanoidRootPart")
        local maxFuel = fuelVal:GetAttribute("Max") or 100

        if fuelVal.Value <= math.floor(maxFuel / 2) and not isFilling then
            isFilling = true
            oldPos = root.CFrame
        end

        if isFilling then
            if fuelVal.Value < maxFuel then
                root.CFrame = CFrame.new(-75, 5, -134)
                if jerryCan:FindFirstChild("ClickDetector") then fireclickdetector(jerryCan.ClickDetector) end
                if generator:FindFirstChild("ClickDetector") then fireclickdetector(generator.ClickDetector) end
            else
                root.CFrame = oldPos
                isFilling = false
            end
        end
    end
end)


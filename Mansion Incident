LocalPlayerTab:CreateSection("Visuals & Utilities")

local CameraModeButton = LocalPlayerTab:CreateButton({
    Name = "Change Camera Mode",
    Callback = function()
        if localPlayer.CameraMode == Enum.CameraMode.LockFirstPerson then
            localPlayer.CameraMode = Enum.CameraMode.Classic
            localPlayer.CameraMinZoomDistance = 0.5
            localPlayer.CameraMaxZoomDistance = 400
        else
            localPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        end
    end,
})

local FullbrightToggle = LocalPlayerTab:CreateToggle({
    Name = "Fullbright",
    CurrentValue = false,
    Flag = "FullbrightToggle",
    Callback = function(Value)
        getgenv().loopfb = Value
        if Value then
            getgenv().fbthread = task.spawn(function()
                while getgenv().loopfb do
                    Lighting.Brightness = 1.5
                    Lighting.ClockTime = 14
                    Lighting.FogEnd = 100000
                    Lighting.GlobalShadows = false
                    Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
                    task.wait()
                end
            end)
        else
            if getgenv().fbthread then
                task.cancel(getgenv().fbthread)
                getgenv().fbthread = nil
            end
            Lighting.GlobalShadows = true
        end
    end,
})


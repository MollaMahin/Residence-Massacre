local LocalPlayerTab = Window:CreateTab("Local Player", "user")

---------------------------------------------------------
-- MAIN TAB
---------------------------------------------------------
MainTab:CreateSection("Mansion Incident Automations")

local kidDetectorConn
local isKidDetected = false

local KidDetectorToggle = MainTab:CreateToggle({
    Name = "Kid Detector",
    CurrentValue = false,
    Flag = "KidDetectorToggle",
    Callback = function(Value)
        if Value then
            kidDetectorConn = RunService.Heartbeat:Connect(function()
                local kidExists = workspace:FindFirstChild("Kid") ~= nil
                if kidExists and not isKidDetected then
                    Rayfield:Notify({
                        Title = "Kid Detector Notification",
                        Content = "A Kid appeared in the door!",
                        Duration = 6,
                        Image = "baby"
                    })
                end
                isKidDetected = kidExists
            end)
        else
            if kidDetectorConn then
                kidDetectorConn:Disconnect()
                kidDetectorConn = nil
            end
            isKidDetected = false
        end
    end,
})

local FillCandyBowlButton = MainTab:CreateButton({
    Name = "Fill Candy Bowl",
    Callback = function()
        pcall(function()
            if workspace:FindFirstChild("FakeCandyBag") and workspace.FakeCandyBag:FindFirstChild("ClickDetector") then
                fireclickdetector(workspace.FakeCandyBag.ClickDetector)
            end
        end)
        pcall(function()
            if workspace:FindFirstChild("CandyBowl") and workspace.CandyBowl:FindFirstChild("ClickDetector") then
                fireclickdetector(workspace.CandyBowl.ClickDetector)
            end
        end)

        task.wait(2.5)

        pcall(function()
            if workspace:FindFirstChild("CandyBowl") and workspace.CandyBowl:FindFirstChild("ClickDetector") then
                fireclickdetector(workspace.CandyBowl.ClickDetector)
            end
        end)
        pcall(function()
            if workspace:FindFirstChild("FakeCandyBag") and workspace.FakeCandyBag:FindFirstChild("ClickDetector") then
                fireclickdetector(workspace.FakeCandyBag.ClickDetector)
            end
        end)

        task.wait(1.6)

        pcall(function()
            if workspace:FindFirstChild("CandyBowl") and workspace.CandyBowl:FindFirstChild("ClickDetector") then
                fireclickdetector(workspace.CandyBowl.ClickDetector)
            end
        end)
    end,
})

MainTab:CreateSection("Player Modifiers")

local InfStaminaButton = MainTab:CreateButton({
    Name = "Infinite Stamina",
    Callback = function()
        local char = getCharacter()
        local sprint = char:WaitForChild("Sprint", 5)
        if sprint then
            if sprint:FindFirstChild("Overdrive") then
                sprint.Overdrive.Value = math.huge
            end
            if sprint:FindFirstChild("Stam") then
                sprint.Stam.Value = math.huge
            end
            Rayfield:Notify({
                Title = "Notification",
                Content = "Infinite Stamina Applied!",
                Duration = 4,
                Image = "chevrons-right"
            })
        end
    end,
})

local RemoveDangerButton = MainTab:CreateButton({
    Name = "Remove Danger",
    Callback = function()
        local char = localPlayer.Character
        if char then
            local danger = char:FindFirstChild("Danger")
            if danger then
                danger:Destroy()
                Rayfield:Notify({
                    Title = "Notification",
                    Content = "Danger removed!",
                    Duration = 4,
                    Image = "chevrons-right"
                })
            end
        end
    end,
})

